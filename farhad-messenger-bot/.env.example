# =============================================================================
# Farhad Messenger AI Bot — পরিবেশ কনফিগারেশন (.env)
# গোপন তথ্য: এই ফাইলটি কখনো গিটহাবে আপলোড করবেন না।
# ব্যবহারের আগে .env.example কে কপি করে .env নামে সেভ করুন এবং প্রকৃত মান দিন।
# =============================================================================

# ফেসবুক অ্যাপের অ্যাপ সিক্রেট (Facebook App Dashboard থেকে পাবেন)
APP_SECRET=your_app_secret_here

# পেজ অ্যাক্সেস টোকেন (পেজের জন্য জেনারেট করা টোকেন)
PAGE_ACCESS_TOKEN=your_page_access_token_here

# ওয়েবহুক ভেরিফিকেশন টোকেন (আপনি নিজেই কোনো গোপন স্ট্রিং সেট করুন)
VERIFY_TOKEN=your_verify_token_here

# বটের এডমিন ফেসবুক ইউজার আইডি (কমা দিয়ে আলাদা করুন,etlen multiple admin থাকতে পারে)
ADMIN_USER_IDS=

# এআই প্রোভাইডার: rule-based (অভ্যন্তরীণ regras-ভিত্তিক) অথবা openai (বাহ্যিক OpenAI API)
AI_PROVIDER=rule-based

# ওপেনএআই এপিআই কী (শুধুমাত্র AI_PROVIDER=openai হলে প্রয়োজন)
OPENAI_API_KEY=

# সার্ভার যে পোর্টে চলবে
PORT=3000

# বট চালু/বন্ধের প্রাথমিক অবস্থা (true = চালু, false = বন্ধ)
BOT_ENABLED=true

# কমান্ড প্রিফিক্স (বটের কমান্ড চালু করতে এই চिह্ন ব্যবহার করুন)
COMMAND_PREFIX=!
