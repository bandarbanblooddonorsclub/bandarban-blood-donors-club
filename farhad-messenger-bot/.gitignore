# =============================================================================
# Farhad Messenger AI Bot — .gitignore
# =============================================================================

# গোপন পরিবেশ ফাইল (কখনো আপলোড করবেন না)
.env
.env.local
.env.*.local

# নোড মডিউল
node_modules/

# লগ ফোল্ডার
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ডাটাবেজ ফোল্ডার (JSON ডাটাবেজ সেভ হয় এখানে)
data/
*.json

# অপারেটিং সিস্টেম ফাইল
.DS_Store
Thumbs.db

# আইডিই / এডিটর
.vscode/
.idea/
*.swp
*.swo
*~

# কাভারেজ ও বিল
coverage/
dist/
build/

# টম্প ফাইল
.tmp/
*.tmp
